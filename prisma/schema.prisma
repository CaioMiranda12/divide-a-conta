generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BillStatus {
  processing
  draft
  open
  closed
  failed
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  ownedBills   Bill[]        @relation("BillOwner")
  participants Participant[]

  @@map("users")
}

model Bill {
  id                 String     @id @default(uuid())
  userId             String     @map("user_id")
  imageUrl           String     @map("image_url")
  restaurantName     String?    @map("restaurant_name")
  totalAmountInCents Int        @default(0) @map("total_amount_in_cents")
  serviceFeePercent  Int        @default(0) @map("service_fee_percent")
  status             BillStatus @default(processing)
  createdAt          DateTime   @default(now()) @map("created_at")

  owner        User          @relation("BillOwner", fields: [userId], references: [id])
  items        BillItem[]
  participants Participant[]

  @@map("bills")
}

model BillItem {
  id           String @id @default(uuid())
  billId       String @map("bill_id")
  description  String
  priceInCents Int    @map("price_in_cents")
  quantity     Int    @default(1)

  bill   Bill        @relation(fields: [billId], references: [id], onDelete: Cascade)
  claims ItemClaim[]

  @@map("bill_items")
}

model Participant {
  id        String   @id @default(uuid())
  billId    String   @map("bill_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  bill   Bill        @relation(fields: [billId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id])
  claims ItemClaim[]

  @@unique([billId, userId])
  @@map("participants")
}

model ItemClaim {
  id            String @id @default(uuid())
  billItemId    String @map("bill_item_id")
  participantId String @map("participant_id")
  splitCount    Int    @default(1) @map("split_count")

  billItem    BillItem    @relation(fields: [billItemId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([billItemId, participantId])
  @@map("item_claims")
}
